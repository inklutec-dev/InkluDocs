msgstr "Répéter le nouveau mot de passe"

msgid "Kontoinformationen"
msgstr "Informations du compte"

msgid "Wird geladen ..."
msgstr "Chargement …"

msgid "API-Schluessel"
msgstr "Clés API"

msgid "Mit API-Schluesseln koennen externe Anwendungen Alt-Texte generieren."
msgstr "Les clés API permettent à des applications externes de générer des textes alternatifs."

msgid "Neuen Schluessel erstellen"
msgstr "Créer une nouvelle clé"

msgid "Erstellen"
msgstr "Créer"

msgid "Name fuer neuen API-Schluessel"
msgstr "Nom de la nouvelle clé API"

msgid "Name (z. B. Meine App)"
msgstr "Nom (p. ex. Mon appli)"

msgid "Geben Sie einen Namen ein, um den Schluessel spaeter zuordnen zu koennen."
msgstr "Saisissez un nom pour pouvoir identifier la clé plus tard."

msgid "Meine API-Schluessel"
msgstr "Mes clés API"

msgid "API-Schluessel bearbeiten"
msgstr "Modifier la clé API"


