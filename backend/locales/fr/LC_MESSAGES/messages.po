msgstr "Chargement …"

msgid "API-Schluessel"
msgstr "Clés API"

msgid "Mit API-Schluesseln koennen externe Anwendungen Alt-Texte generieren."
msgstr "Les clés API permettent à des applications externes de générer des textes alternatifs."

msgid "Neuen Schluessel erstellen"
msgstr "Créer une nouvelle clé"

msgid "Erstellen"
msgstr "Créer"

