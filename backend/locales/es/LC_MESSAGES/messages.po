msgstr "Nueva contraseña (mín. 8 caracteres)"

msgid "Neues Passwort wiederholen"
msgstr "Repetir la nueva contraseña"

msgid "Kontoinformationen"
msgstr "Información de la cuenta"

msgid "Wird geladen ..."
msgstr "Cargando …"

msgid "API-Schluessel"
msgstr "Claves API"

msgid "Mit API-Schluesseln koennen externe Anwendungen Alt-Texte generieren."
msgstr "Las claves API permiten que aplicaciones externas generen textos alternativos."

msgid "Neuen Schluessel erstellen"
msgstr "Crear una nueva clave"

msgid "Erstellen"
msgstr "Crear"

msgid "Name fuer neuen API-Schluessel"
msgstr "Nombre de la nueva clave API"

msgid "Name (z. B. Meine App)"
msgstr "Nombre (p. ej. Mi app)"

msgid "Geben Sie einen Namen ein, um den Schluessel spaeter zuordnen zu koennen."
msgstr "Introduzca un nombre para poder identificar la clave más tarde."

msgid "Meine API-Schluessel"
msgstr "Mis claves API"

msgid "API-Schluessel bearbeiten"
msgstr "Editar clave API"


