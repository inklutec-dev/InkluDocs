msgstr "Really delete the project “{name}” and all of its data?"

msgid "Projekt gelöscht"
msgstr "Project deleted"

msgid "Löschen fehlgeschlagen."
msgstr "Deleting failed."

msgid "{n} Projekte geladen."
msgstr "{n} projects loaded."

msgid "Bitte einen Projektnamen eingeben."
msgstr "Please enter a project name."

msgid "Bitte ein Werkzeug auswählen."
msgstr "Please choose a tool."

msgid "Projekt wird angelegt …"
msgstr "Creating project …"

msgid "Angelegt – wird geöffnet …"
msgstr "Created – opening …"

msgid "Anlegen fehlgeschlagen."
msgstr "Creating the project failed."

msgid "Netzwerkfehler. Bitte erneut versuchen."
msgstr "Network error. Please try again."

